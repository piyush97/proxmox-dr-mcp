# Proxmox DR MCP — Environment Configuration
# Copy this to .env and fill in your values

# Required: Proxmox host address
PROXMOX_HOST=192.168.1.100

# Proxmox API Token credentials
# Create at: Datacenter → Permissions → API Tokens
PROXMOX_TOKEN_ID=my-token-id
PROXMOX_TOKEN_VALUE=my-token-secret
PROXMOX_TOKEN_USER=root@pam

# SSL: set to true if you have valid certs
PROXMOX_VERIFY_SSL=false

# Default Proxmox node name
NODE=pve

# Snapshot naming prefix
DEFAULT_SNAPSHOT_PREFIX=dr-

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
